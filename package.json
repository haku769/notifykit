{
  "name": "notifykit",
  "version": "1.0.0",
  "description": "Biblioteca TypeScript para envio de notificações multicanal, extensível via Design Patterns.",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "example:basic": "tsx examples/01-uso-padrao.ts",
    "example:custom": "tsx examples/02-extensao.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "notification",
    "email",
    "slack",
    "webhook",
    "design-patterns"
  ],
  "author": "João Guilherme Marques, Mateus Nathan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
